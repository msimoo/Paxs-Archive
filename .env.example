# Copy to .env and adjust. All values are overridable via environment variables.

# --- Database ---
# PostgreSQL is the only supported database (14+; 16/17 recommended).
# Create the role and database first (psql as the postgres superuser):
#   CREATE ROLE paxs_user LOGIN PASSWORD 'change-me';
#   CREATE DATABASE paxs_db OWNER paxs_user ENCODING 'UTF8' TEMPLATE template0;
# The schema is created on first start (Alembic baseline), or from
# Settings -> Database -> Initialize.
DATABASE_URL=postgresql+asyncpg://paxs_user:change-me@localhost:5432/paxs_db
# Connection-pool defaults are conservative starting values only.
# Set production values from docs/db-sizing.md after DBA capacity review;
# keep (pool + overflow) x engines x APP_WORKERS below max_connections.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=5
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=1800
DB_MAX_CONNECTIONS=0
APP_WORKERS=1
DB_READ_ACQUIRE_RETRIES=1
DB_READ_RETRY_DELAY_SECONDS=0.1
# Optional hot-standby replica for the hottest reads (Admin -> DB Pool):
# DB_READ_REPLICA_URL=postgresql+asyncpg://paxs_ro:change-me@replica-host:5432/paxs_db

# --- DICOM DIMSE receiver (C-STORE / C-FIND / C-GET) ---
DICOM_AE_TITLE=PAXS_SCP
DICOM_HOST=0.0.0.0
DICOM_PORT=10400
DICOM_RECEIVER_ENABLED=true
# Optional absolute path to an OFFIS DCMTK bin directory for native DIMSE tools.
DCMTK_BIN_DIR=
# Dedicated C-MOVE receiver; 0 disables it. Register the AE and port on the peer
# and restrict inbound access to the peer at the host/network firewall.
DCMTK_MOVE_PORT=0
DCMTK_MOVE_AE_TITLE=PAXS_MOVE
# Optional absolute path to the vendor storescp.cfg (AllDICOM profile).
DCMTK_MOVE_PROFILE=
# Maximum tracked/pending Storage Commitment requests in memory. Bounds the
# association map and dispatch queue; 0 disables N-ACTION admission (0xA700).
STORAGE_COMMIT_MAX_PENDING=256
# Maximum calling-AE to tenant mappings cached in process; 0 disables this
# optimization and always resolves the mapping from the database.
DICOM_TENANT_AE_CACHE_MAX_ENTRIES=1024

# A-17: enforce PS3.5 UID grammar (digits and dots) on the mandatory Type 1
# UIDs — StudyInstanceUID, SeriesInstanceUID, SOPInstanceUID — at ingest.
# A missing, blank or placeholder ("UNKNOWN") UID is always rejected; this
# switch only governs the *format* rule. Set to false only for an archive that
# genuinely contains legacy non-conformant UIDs, which are then accepted with a
# warning naming each one instead of being refused.
DICOM_UID_STRICT_FORMAT=true

# --- DICOM TLS (encrypt the DIMSE channel, AES over TLS 1.2/1.3) ---
# A self-signed certificate is generated into DICOM_TLS_CERT/KEY on first
# start when the files are missing (requires `openssl` on PATH). For
# production, provide real certs and set DICOM_TLS_CA to your hospital CA to
# also require + verify client certificates (mutual TLS).
DICOM_TLS_ENABLED=false
DICOM_TLS_CERT=./certs/paxs.crt
DICOM_TLS_KEY=./certs/paxs.key
DICOM_TLS_CA=
# B-16: DICOM_TLS_CA is also the SCU's trust anchor. When TLS is enabled and
# neither this nor a per-node `trust_cert` pin is set, a production SCU REFUSES
# to connect (fail closed) instead of encrypting to an unverified peer. Point
# this at your hospital CA, or pin each node's certificate in the Nodes panel.

# B-8: calling AE titles allowed to associate (comma-separated, case-insensitive).
# EMPTY = no allowlist (any AE may associate — the pre-B-8 behaviour). When set,
# any AE not listed here AND not registered in the Nodes panel is rejected at
# association with an A-ASSOCIATE-RJ (calling AE title not recognised).
DICOM_ALLOWED_CALLING_AES=

# --- Storage ---
STORAGE_ROOT=./storage
# Maximum cached backend objects across named and environment backends; 0 disables caching.
STORAGE_BACKEND_CACHE_MAX_ENTRIES=128
# Sample first/middle/last objects for viewer series availability. 0 disables the endpoint.
AVAILABILITY_SAMPLE_PER_SERIES=3
# Maximum object-presence checks per request. 0 reports unknown without storage I/O.
AVAILABILITY_MAX_CHECKS=300
# Storage keys must resolve inside STORAGE_ROOT. When enabled, this only permits
# read-only legacy absolute keys already inside that root, or CWD-relative
# "storage/..." keys when CWD/storage is the same canonical STORAGE_ROOT.
STORAGE_ALLOW_LEGACY_PATHS=false
# B-18: the only directories a legacy absolute key may resolve into *beyond*
# STORAGE_ROOT. Comma- or path-separator-separated absolute paths, read-only,
# matched after canonical (symlink-resolved) path resolution. Empty = legacy
# absolute keys stay confined to STORAGE_ROOT. Point this at a pre-migration
# layout during a one-shot migration, then clear it.
STORAGE_LEGACY_ROOTS=
# H09: the background sweeper for abandoned staged objects. A crash between
# staging and promoting leaves a .tmp_* file behind; the sweeper deletes staged
# temp files older than STORAGE_STALE_THRESHOLD_SECONDS every
# STORAGE_SWEEP_INTERVAL_SECONDS. A published object is never a candidate, so
# raising the threshold (or lowering it) cannot damage the archive. 0 disables
# the sweep for either value.
STORAGE_SWEEP_INTERVAL_SECONDS=3600
STORAGE_STALE_THRESHOLD_SECONDS=3600
# STOW-RS request caps apply to inbound requests and outbound uploads. The local
# receiver streams each part to disk; outbound uploads stream from storage and
# the ordinary path uses a disk spool. MAX_INSTANCE_UPLOAD_BYTES is the hard
# inbound per-instance ceiling. STOW_MAX_PART_BYTES / STOW_MAX_TOTAL_BYTES cap
# each part and the whole request (0 = cap disabled).
MAX_INSTANCE_UPLOAD_BYTES=536870912
STOW_MAX_PART_BYTES=2147483648
STOW_MAX_TOTAL_BYTES=4294967296
# Max concurrent STOW object promotions (S3 uploads / renames) per process; 0 disables the cap.
STOW_MAX_CONCURRENT_PROMOTIONS=4
# XDS registration decoded-document and serialized JSON request ceilings.
# The request limit includes Base64/JSON overhead; 0 disables the respective cap.
XDS_MAX_DOCUMENT_BYTES=16777216
XDS_MAX_REQUEST_BYTES=23068672

# Maximum buffered QIDO-RS response from a remote node (16 MiB).
DICOMWEB_QIDO_MAX_BYTES=16777216
# Maximum buffered STOW-RS response body from a remote node (1 MiB).
DICOMWEB_STOW_MAX_RESPONSE_BYTES=1048576
# Maximum concurrent outbound STOW uploads (streamed and regular). 0 disables
# outbound STOW; excess requests receive HTTP 503 until a slot is free.
NODE_TRANSFER_STOW_MAX_CONCURRENT=4

# --- Background task pool (C-4 / C-5) ---
# One shared, bounded ThreadPoolExecutor carries every background task
# (warm-on-open and script event dispatch). Without it, each study opened and
# each script event spawned a raw daemon thread, so a burst could exhaust the
# process's threads. BACKGROUND_MAX_THREADS=0 disables background dispatch
# entirely (honoured literally); BACKGROUND_QUEUE_MAX caps the backlog, past
# which a new task is dropped/debounced rather than queued without bound.
BACKGROUND_MAX_THREADS=8
BACKGROUND_QUEUE_MAX=64

# --- Trusted admin scripts ---
# Registry count and source size caps. Zero disables script registration/loading.
SCRIPTS_MAX_COUNT=256
SCRIPTS_MAX_SOURCE_BYTES=262144
# Chained dispatch caps; zero disables chaining (top-level events still run).
SCRIPTS_MAX_CHAIN_DEPTH=5
SCRIPTS_MAX_CHAIN_PER_SECOND=50

# --- Compression / background worker ---
# RLE (built-in) | JPEG-LS | JPEG2000 | HTJ2K
# D-7: must match `config.DEFAULT_COMPRESSION`. The example said RLE while the
# code defaulted to JPEG-LS, so a deployment that copied this file silently got
# ~3x larger archives than the documented default.
DEFAULT_COMPRESSION=JPEG-LS
COMPRESSION_ENABLED=true
# Lossy re-compression is destructive/irreversible — OFF by default (fail-closed).
# Supported targets: JPEG-LS Near-Lossless (1.2.840.10008.1.2.4.81) and
# JPEG 2000 Lossy (1.2.840.10008.1.2.4.91). Only uncompressed or verified-lossless
# sources are eligible; already-lossy instances are never re-encoded.
LOSSY_COMPRESSION_ENABLED=false
THUMBNAIL_ENABLED=true
WORKER_ENABLED=true
WORKER_POLL_SECONDS=5
# Index/object reconciliation (H-07): every N worker ticks, check this many
# instances for a missing stored object and audit each as OBJECT_MISSING.
# Rows are never deleted. 0 disables.
STORAGE_RECONCILE_SWEEP_EVERY_TICKS=360
STORAGE_RECONCILE_BATCH_SIZE=200
WORKER_JOB_LEASE_SECONDS=300
WORKER_JOB_HEARTBEAT_SECONDS=30
WORKER_JOB_MAX_ATTEMPTS=3
TRANSFER_JOB_QUEUE_CAP=100

# Process-local entries for per-backend /stats storage usage; 0 disables local retention.
STATS_USAGE_CACHE_MAX_ENTRIES=128

# --- Redis cache (L2 tier �� strongly recommended for the viewer) ---
# Redis backs the shared second-level caches that make MPR slicing and slice
# scrubbing fast and let a multi-node deployment share them:
#   * decoded frame pixels       paxs:frame:{sop}:{idx}
#   * materialised HU volumes    paxs:vol:array:{series}:{n}
#   * server-rendered PNG tiles  (series+plane+index+window)
# When false (or when Redis is unreachable) the archive silently falls back to
# the in-process L1 caches only. That still works, but the L1 volume cache holds
# just 8 volumes and the frame LRU is small, so concurrent server-mode viewers
# thrash and re-decode from disk. Set this to true on any real deployment.
REDIS_CACHE_ENABLED=true
# Bounded Redis socket timeouts; failed cache operations degrade to misses.
REDIS_CONNECT_TIMEOUT_SECONDS=0.5
REDIS_COMMAND_TIMEOUT_SECONDS=1.0
# Open the Redis circuit after repeated errors; probe after this delay.
REDIS_CIRCUIT_FAILURE_THRESHOLD=5
REDIS_CIRCUIT_RESET_SECONDS=10
# Dedicated sync I/O executor admission = active threads + queued calls.
BLOCKING_IO_MAX_THREADS=16
BLOCKING_IO_QUEUE_MAX=64
REDIS_URL=redis://127.0.0.1:6379/0

# --- In-process cache memory budgets ---
# Hard byte ceilings for the two decode caches. These are independent of
# HYBRID_SERVER_VOL_BUDGET_MB below: that one is a *policy* input to viewer mode
# negotiation ("how much volume work does this server intend to do"), whereas
# these are *hard caps* enforced by the caches themselves, so a negotiation
# change can never silently raise the process's worst-case RSS.
#
# Both replace previous hardcoded entry counts (8 volumes / 16 frames) that were
# far too small: 8 volumes is less than HYBRID_MAX_SERVER_MPR_SESSIONS, and 16
# frames of a 512x512 CT is ~8 MB, so the caches thrashed under the load they
# were built for and re-decoded from disk instead of serving hits.
#
# Watch paxs_cache_operations_total / paxs_cache_utilisation_ratio on /metrics:
# a persistently high miss rate means raise the budget; a ratio pinned at 1.0
# means the cache is evicting to serve every request.
#
# --- PAXS Viewer MPR/3D processing policy ---
VIEWER_PROCESSING_MODE=hybrid
HYBRID_CLIENT_SCORE_THRESHOLD=40
# Zero disables this shedding signal. The effective cache threshold is clamped
# to the lower enabled value of this policy budget and VOLUME_CACHE_BUDGET_MB.
HYBRID_SERVER_VOL_BUDGET_MB=768
HYBRID_RTT_THRESHOLD_MS=150
# Zero disables this session-count signal; valid range is 0..4096.
HYBRID_MAX_SERVER_MPR_SESSIONS=20
VIEWER_PROCESSING_ROLE_MAP=

# VOLUME_CACHE_BUDGET_MB caps materialised volumes (float32 HU arrays; ~500 MB
# per 512x512x500 CT). Zero disables this cache; it is also the hard upper
# bound for cache-based server shedding.
VOLUME_CACHE_BUDGET_MB=1024
VOLUME_BUNDLE_CACHE_BUDGET_MB=128
# Single-flight waiters share one volume build; a bounded takeover follows these waits.
VOLUME_SINGLEFLIGHT_WAIT_SECONDS=180
VOLUME_SINGLEFLIGHT_MAX_WAITS=3
# Temporary working-set budget shared by concurrent cache-miss volume builds.
# 0 disables new builds but keeps already-cached volumes available. A request
# that cannot reserve memory within the bounded wait receives HTTP 503.
VOLUME_ASSEMBLY_BUDGET_MB=2048
# Maximum distinct active cache-miss volume builds (including byte-budget waiters).
# 0 refuses uncached builds while already-cached L1/L2 volumes remain available.
VOLUME_ASSEMBLY_MAX_INFLIGHT=16
VOLUME_ASSEMBLY_MAX_WAITERS=16
VOLUME_ASSEMBLY_WAIT_SECONDS=30
# Strict geometry validator tolerances. The validator is not yet wired into
# volume assembly or HTTP routes; clinical enforcement requires radiology review.
VOLUME_GEOMETRY_IOP_TOLERANCE=0.0001
VOLUME_GEOMETRY_POSITION_TOLERANCE_MM=0.001
VOLUME_GEOMETRY_SPACING_ABS_TOLERANCE_MM=0.001
VOLUME_GEOMETRY_SPACING_REL_TOLERANCE=0.001
#
# DICOM_FRAME_CACHE_MB caps the decoded-frame LRU in the WADO-RS bulk service
# (raw pixel bytes). Bound by bytes rather than entry count so it scales with
# image size. A 512x512 CT frame is ~0.5 MB; a 3072x2560 J2K frame takes ~2.3 s
# to decode, which is what makes hits worth holding on to. Zero disables it.
DICOM_FRAME_CACHE_MB=256

# Byte-range WADO frame path (on by default): multi-frame objects with a provable
# layout on local seekable storage are served by reading only the requested frame;
# all unsupported cases use the existing decoder path. Zero disables the offset cache.
DICOM_FRAME_RANGE_READ_ENABLED=true
DICOM_FRAME_OFFSET_CACHE_MB=64
# Maximum fragments indexed for one encapsulated instance; larger layouts fall back.
DICOM_FRAME_OFFSET_MAX_FRAGMENTS=65536

# Reading claim: seconds without a viewer heartbeat (sent every 60 s) after which
# a study's "being read by" claim is stale and free to take. 0 = never expires.
READING_CLAIM_TTL_SECONDS=300

# AI_MASK_CACHE_BUDGET_MB caps cached experimental HU-mask results by raw mask
# bytes. Masks larger than this budget are served for the request but not held
# in memory. Zero disables AI result caching.
AI_MASK_CACHE_BUDGET_MB=256

# B-10: per-request caps on the volume streaming endpoints.
#   VOLUME_MAX_BYTES — ceiling on one /volume/{series}/data response, checked
#     before any buffer is allocated (413 above it). VOLUME_MAX_SLICES bounds
#     the slice count, not the size: 4096 slices of a 512x512 16-bit volume is
#     ~2 GiB, which the handler used to join into a single bytes object.
#   VOLUME_MAX_TILES — ceiling on one /volume/{series}/tiles batch (each tile
#     costs a reslice plus a PNG encode). Independent of the raw-voxel budget.
VOLUME_MAX_BYTES=268435456
# Aggregate response bytes admitted per application process. A response that
# would exceed the available budget receives 503 with Retry-After. Zero disables
# this aggregate cap; route-specific response limits remain active.
RESPONSE_BYTES_IN_FLIGHT_BUDGET_BYTES=536870912
VOLUME_MAX_TILES=64
# Large Client/Split MPR series use a labelled overview within both limits.
# The slice limit applies after explicit Z sampling; 0 MiB disables overviews.
VOLUME_MPR_CLIENT_MAX_SLICES=1500
VOLUME_MPR_CLIENT_MAX_VOLUME_MB=1
# Prefer a compact orientation volume with at most this many sampled slices.
VOLUME_MPR_CLIENT_OVERVIEW_TARGET_SLICES=86
# Server MPR initial planes for oversized series are sampled and labelled
# orientation overviews (never primary for diagnosis); exact primary viewing
# remains in the DICOM stack viewer.
VOLUME_MPR_OVERVIEW_DOWNSAMPLE=32
# Maximum simultaneous header reads during cold volume discovery.
VOLUME_HEADER_READ_CONCURRENCY=32

# --- Prometheus /metrics access ---
# Unauthenticated scraping is loopback-only by default. Add a specific scraper
# IP/CIDR for remote Prometheus; otherwise authenticate as ADMIN.
METRICS_ALLOW_IPS=127.0.0.1,::1
# Event-loop scheduling delay sample interval; 0 disables sampling.
METRICS_EVENT_LOOP_SAMPLE_SECONDS=1.0

# --- Security ---
# B-1: these defaults are PRODUCTION-SAFE. The shipped default is
# ENVIRONMENT=production, so a deployment that forgets to set it fails closed
# instead of silently skipping every production check. Any value that is not one
# of development/dev/local/test/testing also counts as production, so a typo
# fails closed too.
#
# LOCAL DEVELOPMENT ONLY: uncomment the next line to opt out of the gate.
# (SECRET_KEY below must then be replaced, or startup still refuses to boot.)
# ENVIRONMENT=development
ENVIRONMENT=production
# In production SECRET_KEY must be a random value of 32+ characters. Startup
# REFUSES to boot with the placeholder below - generate one before deploying:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# B-4: one-time token required to create the FIRST administrator over the API.
# Unset (the default) disables API bootstrap entirely, so an empty database
# cannot be claimed by whoever reaches the port first. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset it again once the administrator exists.
# SETUP_TOKEN=
# Session cookie policy. AUTH_COOKIE_SECURE must be true in production (HTTPS
# served directly or terminated by a proxy in front of PAXS).
# AUTH_COOKIE_SAMESITE accepts lax | strict | none.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=lax
# B-19/FS-10: CSRF protection for cookie-authenticated state changes. A signed
# double-submit token is issued at login in a JS-readable "paxs_csrf" cookie and
# must be echoed in the X-CSRF-Token header on POST/PUT/PATCH/DELETE; requests
# carrying an Authorization: Bearer header are exempt. Leave enabled.
CSRF_PROTECTION_ENABLED=true
# Serve HTTPS directly. With HTTPS_ENABLED=true and a missing certificate the
# server aborts in production instead of silently downgrading to plain HTTP.
HTTPS_ENABLED=false
HTTPS_CERT=./certs/https.crt
HTTPS_KEY=./certs/https.key
# D-7: must match `config.TOKEN_EXPIRE_MINUTES` (15). The example said 480,
# so a copied deployment issued 8-hour access tokens against a 15-minute
# documented default — a silent, material widening of the token window.
TOKEN_EXPIRE_MINUTES=15
# H02: self-registration is OFF by default (the first user still bootstraps as
# ADMIN). If you enable it, only non-destructive roles can be requested:
# ADMIN and RADIOLOGIST are always refused for self-registered accounts.
ALLOW_REGISTER=false
REGISTER_ALLOWED_ROLES=PHYSICIAN

# --- Rate limiting (brute-force / abuse protection) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_GLOBAL_PER_MINUTE=300
# Maximum distinct client IPs retained per in-memory rate-limit window. Zero
# disables local fallback storage and returns 503 if Redis is unavailable.
RATE_LIMIT_MAX_LOCAL_CLIENT_BUCKETS=4096
# Only these directly connected proxy IPs/CIDRs may supply rate-limit X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Anonymizer (research export) ---
ANONYMIZER_STRIP_PRIVATE_TAGS=true
ANONYMIZER_STRIP_DATES=true

# --- HL7 / FHIR gateway ---
# HL7 v2 ADT listener (EMR/HIS integration): patients register via ADT^A01.
HL7_ENABLED=false
# Loopback by default: the listener can merge (A40) and rename (A08) patients.
# Bind a LAN address only together with HL7_ALLOWED_SOURCE_IPS.
HL7_HOST=127.0.0.1
HL7_PORT=2575
# Hard caps for inbound MLLP clients and frames.
HL7_MAX_CONCURRENT_CONNECTIONS=20
HL7_MAX_MESSAGE_BYTES=1048576
HL7_SOCKET_TIMEOUT_SECONDS=15
# Comma-separated IPs/CIDRs allowed to connect (e.g. 10.9.0.4,10.20.0.0/24).
# Empty = loopback peers only; every other connection is dropped unread.
HL7_ALLOWED_SOURCE_IPS=
# Optional sender allowlist: comma-separated APPLICATION|FACILITY (MSH-3|MSH-4)
# pairs, e.g. HIS|HOSPITAL,RIS|HOSPITAL. Empty = no sender check.
HL7_ALLOWED_SENDING_FACILITIES=
# MLLP over TLS. A missing/invalid certificate keeps the listener closed.
# HL7_TLS_CA (optional) requires a client certificate from that CA.
HL7_TLS_ENABLED=false
HL7_TLS_CERT=
HL7_TLS_KEY=
HL7_TLS_CA=
# Production refuses a LAN-bound plaintext listener unless this is set.
# Only enable it for a HIS that cannot speak MLLP over TLS, on a trusted VLAN.
HL7_PLAINTEXT_ALLOWED=false
# QBP PIX/PDQ stays denied unless this exact peer IP + MSH sender tuple maps
# to an active tenant. Example: {"10.9.0.4|HIS|HOSPITAL": 12}
HL7_SENDER_TENANT_MAP={}
FHIR_ENABLED=true

# --- AI emergency triage ---
# Detectors run in the background worker and flag findings (a demo
# pneumothorax heuristic ships by default; plug real models into DETECTORS).
TRIAGE_ENABLED=true
TRIAGE_RUN_IN_WORKER=true
TRIAGE_MAX_SLICES_PER_SERIES=8

# --- DICOMweb / API ---
# Anonymous QIDO/WADO reads and STOW writes are separate capabilities.
# Public writes default off, even when anonymous reads are enabled.
# With public reads disabled, authenticated users or a valid share token are required.
# SECURITY: prefer `false` for any archive reachable outside a trusted network.
DICOMWEB_PUBLIC_READ=false
DICOMWEB_PUBLIC_WRITE=false
# P2.0: opt-in PHI-free Server-Timing phases on WADO-RS frame responses.
DICOMWEB_SERVER_TIMING_ENABLED=false
# B-1: a wildcard is REFUSED in production. List the browser origins allowed to
# call the API (comma-separated); the built-in UIs are same-origin and need none.
CORS_ORIGINS=https://pacs.example.org
# Public origin used in patient share links, QR codes, FHIR absolute URLs and
# the admin panel's launch URLs.
#
# MUST be the address a BROWSER can reach: scheme + host [+ port], no path.
# A bind address (0.0.0.0 / ::) is rejected at startup �� it is a *listen*
# address and no browser can resolve it, so links built from one are dead on
# arrival. Leave EMPTY to derive the origin from the incoming request
# (X-Forwarded-Host / Host), which is correct for most single-host installs and
# automatically follows a reverse proxy.
#
# Set it explicitly whenever the public address differs from the one the app is
# reached on internally, e.g. behind TLS termination:
#   PUBLIC_BASE_URL=https://pacs.example.org
PUBLIC_BASE_URL=
# Request Host/X-Forwarded-Host must match this comma-separated list; supports
# exact names and *.example.org patterns. SERVER_HOST is the safe fallback host.
ALLOWED_HOSTS=localhost,127.0.0.1,::1,pacs.example.org
SERVER_HOST=localhost:8000

# --- Reverse proxy / sub-path deployment ---
# Leave BOTH empty when the archive is served at the root of a host or
# subdomain (the default, and the simplest correct setup).
#
# Set them when the app is mounted under a path, e.g. https://example.org/paxs/
# PAXS_ROOT_PATH is the static prefix. The per-request equivalent is the
# X-Forwarded-Prefix header, which is preferred because it lets one deployment
# be reached at several prefixes �� and because it cannot drift from the proxy
# config. Full guide with nginx / Traefik / Caddy / HAProxy blocks:
#   deploy/REVERSE-PROXY.md
PAXS_ROOT_PATH=
#
# Configure both proxy-header trust layers for the actual proxy peer(s):
# FORWARDED_ALLOW_IPS controls PAXS host/prefix middleware; PAXS_FORWARDED_ALLOW_IPS
# controls uvicorn's forwarded-proto/client handling. A proxy in another container
# has a different IP, so include its exact IP/CIDR. Keep this separate from
# TRUSTED_PROXIES (rate-limit X-Forwarded-For) and ALLOWED_HOSTS (permitted hosts).
FORWARDED_ALLOW_IPS=127.0.0.1
PAXS_FORWARDED_ALLOW_IPS=127.0.0.1

# --- LDAP / Active Directory (optional) ---
# Directory login is OFF until enabled here. Every failure mode denies the
# login; roles come from LDAP_GROUP_ROLE_MAP (ADMIN/RADIOLOGIST/PHYSICIAN/
# TECHNOLOGIST). Requires the optional `ldap3` package. LDAP simple binds are
# always encrypted: ldap:// requires StartTLS; ldaps:// uses implicit TLS.
LDAP_ENABLED=false
LDAP_SERVER=
LDAP_BASE_DN=
LDAP_USER_DN_TEMPLATE=uid={username},{base_dn}
LDAP_GROUP_ROLE_MAP=
# Role granted when no group matches. Empty = deny (recommended).
LDAP_DEFAULT_ROLE=
LDAP_TIMEOUT_SECONDS=5
LDAP_USE_TLS=true
# Optional PEM CA bundle. Empty uses the operating-system trust store; production
# certificate validation is always required (only ENVIRONMENT=test/testing skips it).
LDAP_CA_CERT_FILE=
# Set to the active tenant ID for this directory when VNA tenants are configured.
# LDAP_TENANT_ID=1

# --- Licensing (B-2 / FS-7) ---
# The AES-256-GCM key that wraps .lic containers. REQUIRED for any licence to be
# read or written: there is deliberately no built-in default, because the old one
# ("PAXS_ARCHIVE_LIC_SEC_2026_AES25") is public in this repository's history and
# mirrored in the PHP portal — a container "encrypted" with it is plaintext.
# 32 bytes are used as-is; any other length is SHA-256-derived. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep it in a secrets manager, not in the repository.
PAXS_LICENSE_AES_KEY=
# Vendor verification key. Leave empty to use the key embedded in
# app/core/licensing/crypto.py (rotated to RSA-4096 on 2026-10-13). Set the PEM
# here, or a path in PAXS_LICENSE_PUBLIC_KEY_PATH, to rotate without a redeploy.
# A key on the revocation list is refused even when configured explicitly.
PAXS_LICENSE_PUBLIC_KEY=
PAXS_LICENSE_PUBLIC_KEY_PATH=
LDAP_TIMEOUT_SECONDS=5
LDAP_USE_TLS=false

# --- Patient sharing ---
SHARE_EXPIRY_DAYS=30
# Allow old /viewer?share= links to redirect through the secure cookie exchange.
SHARE_LEGACY_VIEWER_LINKS_ENABLED=true

# Production always fails startup on a viewer asset manifest mismatch.
# Development warns by default; set true to fail startup during local integrity work.
VIEWER_MANIFEST_STRICT_DEVELOPMENT=false
