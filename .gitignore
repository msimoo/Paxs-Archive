venv/
.venv/
__pycache__/
*.pyc
.env
paxs.db
paxs.db-wal
paxs.db-shm
# Runtime object store only. MUST stay anchored ("/storage/"): an unanchored
# "storage/" also matches the SOURCE package app/services/storage/, which is how
# that package went missing from the tree (see new_docs P0-1).
/storage/
test_storage/
*.egg-info/
.pytest_cache/
dist/
build/
*.spec

# local MySQL 8.0 used for verification (.tools/mysql*, .tools/mysql-data)
.tools/

# --- Secrets & credentials (NEVER commit) ---
# settings.json contains gateway API keys
.env
settings.json
# TLS private keys and certs
certs/*.key
certs/*.crt
# signed license files
*.lic
paxs_tray_report.json
# vendor license signing keys (generated by scripts/generate_license.py)
scripts/vendor_keys/
# vendor portal operator-local secrets + private keys (see config.local.php.example)
deploy/vendor-portal-php/config.local.php
deploy/vendor-portal-php/*.pem
# vendor portal runtime database
deploy/vendor-portal-php/portal.db
# hosting credentials (contains FTP/MySQL passwords)
infinityfree.md
scripts/upload_to_infinityfree.py

# --- Local data & backups ---
backups/
paxs.db-journal
# agent workspace state
.freebuff/
debug_outputs/
scratch/
# Windows redirect artefacts ("cmd > nul", a stray query dump). Anchored to the
# repository root: unanchored, these would silently hide any file or directory of
# the same name anywhere in the tree (docs/reference 06-tests-hygiene.md H-8).
/nul
/query

# --- Build artifacts ---
build-win/
*.pkg

# --- Large generated viewer assets ---
app/static/viewer/**/*.js.map
app/static/viewer/**/*.min.js.map

# --- Local agent workspace (project memory, scratch, per-session temp) ---
# Never commit: holds the curated project memory (memory/MEMORY.md), the daily
# work logs, and the CI gates' scratch directory.
.workbuddy-ai/

# --- Editor-local MCP server config (machine-specific command + paths) ---
.vscode/mcp.json

# --- Runtime uploads: organisation logos are uploaded through the UI ---
app/static/uploads/*
!app/static/uploads/.gitkeep

# --- Scratch planning outputs ---
outputs/

# --- Root-level 8-character artefacts (D-9) ---
# A local tool writes bare 8-character files at the project root (each one
# contains only `blat` — 60 of them had been staged by a `git add -A` and were
# removed from the index). The class is spelled out one character at a time
# rather than using `*`, so a longer root file cannot be swallowed by it.
#
# Two root entries are exactly 8 characters: `new_docs/` (tracked docs) and
# `paxs.lic` (a licence, not matched — it contains a dot). `new_docs/` is
# re-included below on purpose: a tracked directory is unaffected by this rule,
# but if it were ever removed and re-created, every new file inside it would
# silently vanish from `git status` and from the next commit.
# `tools/ci/check_staged_junk.py` is the authoritative gate for this class — a
# pattern here only stops the files being *offered* to `git add`, it cannot stop
# them being staged by force, and it says nothing about `.env` or `*.db`.
/[A-Za-z0-9_][A-Za-z0-9_][A-Za-z0-9_][A-Za-z0-9_][A-Za-z0-9_][A-Za-z0-9_][A-Za-z0-9_][A-Za-z0-9_]
!/new_docs/

# PAXS Viewer workstation build output
/dist-desktop/
/dist-desktop-fixed/
/desktop_viewer/.venv/
/desktop_viewer/build/
/desktop_viewer/*.spec


# Generated by the graphify tool; never commit these.
viewer-src/**/graphify-out/
