        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(paxs_worker_queue_depth{state=\"pending\"})",
          "legendFormat": "pending",
          "refId": "A"
        },
        {
          "expr": "sum(paxs_worker_queue_depth{state=\"running\"})",
          "legendFormat": "running",
          "refId": "B"
        }
      ],
      "title": "Queue now (pending / running)",
      "type": "stat"
